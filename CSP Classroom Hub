<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content="Classroom Hub - classroom management and collaboration platform" />
<title>Classroom Hub</title>
<style>
:root{
  --bg:#07111f; --panel:rgba(15,27,46,.88); --panel2:rgba(22,38,63,.82);
  --text:#f7fbff; --muted:#a9bad0; --line:rgba(255,255,255,.11);
  --accent:#55d6ff; --accent2:#7b61ff; --good:#37d67a; --warn:#ffc857; --danger:#ff647c;
  --shadow:0 18px 55px rgba(0,0,0,.28); --radius:20px;
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--text)}
body{background:#07111f;overflow-x:hidden;position:relative}
body::before{content:"";position:fixed;inset:-12px;z-index:-2;background:url("data:image/png;base64,") center/cover;filter:blur(4px);transform:scale(1.03)}
body::after{content:"";position:fixed;inset:0;z-index:-1;background:rgba(5,18,32,.42);pointer-events:none}
button,input,textarea,select{font:inherit}
button{cursor:pointer}
.app{min-height:100vh}
.topbar{
  position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:16px;
  padding:14px 22px;background:rgba(5,13,25,.78);backdrop-filter:blur(18px);
  border-bottom:1px solid var(--line)
}
.brand{font-weight:850;letter-spacing:-.04em;font-size:1.25rem;white-space:nowrap}
.brand span{color:var(--accent)}
.class-pill,.live-pill{padding:8px 12px;border:1px solid var(--line);background:rgba(255,255,255,.06);border-radius:999px;color:var(--muted);font-size:.85rem}
.live-pill{margin-left:auto;color:#fff}
.live-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--good);box-shadow:0 0 10px var(--good);margin-right:7px}
.role-select,.icon-btn,.primary,.secondary,.danger,.signal,.mode-btn,.preset{
  border:1px solid var(--line);border-radius:12px;color:var(--text);background:rgba(255,255,255,.06);
  transition:.18s ease;min-height:42px
}
.role-select{padding:0 12px}
.icon-btn{width:42px;padding:0}
button:hover{transform:translateY(-1px);border-color:rgba(255,255,255,.25);background:rgba(255,255,255,.1)}
button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:3px solid rgba(85,214,255,.4);outline-offset:2px}
.primary{background:linear-gradient(135deg,var(--accent2),#4777ff);border:0;padding:0 16px;font-weight:750}
.secondary{padding:0 14px}
.danger{padding:0 14px;background:rgba(255,100,124,.12);color:#ffd7de}
main{max-width:1500px;margin:auto;padding:26px}
.hero{display:grid;grid-template-columns:1.35fr .65fr;gap:18px;margin-bottom:18px}
.hero-card,.card{
  background:linear-gradient(145deg,rgba(17,32,54,.78),rgba(10,23,41,.68));
  border:1px solid var(--line);box-shadow:var(--shadow);border-radius:var(--radius)
}
.hero-card{padding:26px}
.eyebrow{text-transform:uppercase;letter-spacing:.13em;font-size:.72rem;color:var(--accent);font-weight:800}
h1,h2,h3,p{margin-top:0}
h1{font-size:clamp(2rem,4vw,3.7rem);line-height:.98;letter-spacing:-.055em;margin:8px 0 14px}
h2{font-size:1.05rem;letter-spacing:-.02em;margin-bottom:14px}
.muted{color:var(--muted)}
.clock-card{display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:20px}
.clock{font-size:clamp(2.5rem,5vw,4.8rem);font-weight:800;letter-spacing:-.06em;font-variant-numeric:tabular-nums}
.date{color:var(--muted);font-size:.95rem}
.dashboard{display:grid;grid-template-columns:1.15fr .85fr;gap:18px}
.card{padding:20px}
.now-playing{min-height:270px;display:flex;flex-direction:column}
.now-head{display:flex;align-items:flex-start;justify-content:space-between;gap:15px}
.activity-title{font-size:1.7rem;font-weight:800;margin:4px 0}
.mode-tag{display:inline-flex;align-items:center;gap:7px;padding:7px 10px;border-radius:999px;background:rgba(85,214,255,.1);color:#b9efff;font-size:.78rem;font-weight:750}
.timer{font-size:clamp(4rem,9vw,7.5rem);font-weight:850;letter-spacing:-.08em;text-align:center;margin:8px 0;font-variant-numeric:tabular-nums}
.timer.warning{color:var(--warn);text-shadow:0 0 30px rgba(255,200,87,.18)}
.timer.done{color:var(--danger)}
.progress{height:8px;background:rgba(255,255,255,.08);border-radius:999px;overflow:hidden;margin:0 0 16px}
.progress > div{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));width:0%;transition:width .25s}
.controls{display:flex;flex-wrap:wrap;justify-content:center;gap:9px}
.presets{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.preset{padding:8px 11px;font-size:.82rem}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.quick-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.mode-btn{padding:14px;text-align:left;min-height:86px}
.mode-btn strong{display:block;margin-bottom:5px}
.mode-btn small{color:var(--muted);line-height:1.35}
.mode-btn.active{border-color:var(--accent);background:rgba(85,214,255,.12);box-shadow:0 0 0 1px rgba(85,214,255,.15) inset}
.signal-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}
.signal{padding:13px 9px;font-weight:750}
.signal.active{background:rgba(85,214,255,.18);border-color:var(--accent)}
.status-list{display:grid;gap:10px}
.status{display:flex;align-items:center;justify-content:space-between;padding:11px 12px;border-radius:13px;background:rgba(255,255,255,.045);border:1px solid var(--line)}
.badge{padding:4px 9px;border-radius:999px;font-size:.75rem;font-weight:800}
.yellow{background:rgba(255,200,87,.14);color:#ffd978}.blue{background:rgba(85,214,255,.13);color:#9ce9ff}.green{background:rgba(55,214,122,.13);color:#8ff1b5}.red{background:rgba(255,100,124,.13);color:#ffb1bf}
.section{margin-top:18px}
.section-title{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px}
.activity-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.activity-card{padding:16px;border-radius:17px;border:1px solid var(--line);background:rgba(255,255,255,.045);cursor:pointer;min-height:140px}
.activity-card:hover{border-color:rgba(255,255,255,.25)}
.activity-card .icon{font-size:1.65rem}
.activity-card h3{font-size:1rem;margin:8px 0 5px}
.activity-card p{font-size:.82rem;color:var(--muted);line-height:1.4;margin:0}
.form{display:grid;gap:11px}
.form label{font-size:.78rem;color:var(--muted);font-weight:700}
.form input,.form textarea,.form select{
  width:100%;padding:11px 12px;border-radius:11px;border:1px solid var(--line);background:rgba(0,0,0,.18);color:var(--text)
}
.form textarea{min-height:90px;resize:vertical}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.modal{position:fixed;inset:0;z-index:50;display:none;align-items:center;justify-content:center;padding:18px;background:rgba(0,0,0,.65);backdrop-filter:blur(7px)}
.modal.open{display:flex}
.modal-box{width:min(760px,100%);max-height:90vh;overflow:auto;background:#0d1a2d;border:1px solid var(--line);border-radius:22px;box-shadow:0 30px 100px rgba(0,0,0,.55);padding:22px}
.modal-head{display:flex;align-items:center;justify-content:space-between}
.help-guide{display:grid;gap:10px}
.guide-step{padding:15px;border-radius:14px;background:rgba(255,255,255,.05);border:1px solid var(--line)}
.projector{position:fixed;inset:0;z-index:100;display:none;padding:4vw;background:linear-gradient(135deg,rgba(5,16,31,.94),rgba(16,39,68,.94)),url("data:image/png;base64,") center/cover;color:#fff}
.projector.open{display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center}
.projector .p-mode{font-size:clamp(1rem,2vw,1.6rem);font-weight:800;color:#b8efff;letter-spacing:.12em;text-transform:uppercase}
.projector h1{font-size:clamp(2.8rem,7vw,7rem);max-width:1100px;margin:14px 0}
.projector .p-instructions{font-size:clamp(1.3rem,3vw,2.5rem);max-width:1050px;line-height:1.25}
.projector .p-timer{font-size:clamp(5rem,14vw,12rem);font-weight:850;letter-spacing:-.08em;font-variant-numeric:tabular-nums}
.projector .p-meta{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;font-size:clamp(1rem,2vw,1.5rem)}
.projector-close{position:absolute;top:20px;right:20px}
.toast{position:fixed;right:18px;bottom:18px;z-index:200;transform:translateY(20px);opacity:0;pointer-events:none;background:#10223b;border:1px solid var(--line);padding:13px 16px;border-radius:13px;box-shadow:var(--shadow);transition:.22s}
.toast.show{transform:translateY(0);opacity:1}
.student-view .teacher-only{display:none}
.student-view .hero{grid-template-columns:1fr}
.student-view .dashboard{grid-template-columns:1fr}
.student-view .student-hidden{display:none}
@media(max-width:1050px){.hero,.dashboard{grid-template-columns:1fr}.activity-cards{grid-template-columns:repeat(2,1fr)}}
@media(max-width:700px){
  main{padding:15px}.topbar{padding:11px 14px;flex-wrap:wrap}.live-pill{margin-left:0}
  .grid,.quick-grid,.form-row{grid-template-columns:1fr}.activity-cards{grid-template-columns:1fr}.signal-grid{grid-template-columns:repeat(2,1fr)}
  .hero-card{padding:20px}.card{padding:16px}.clock{font-size:3rem}.timer{font-size:4.4rem}
}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
.objective-box{margin:18px 0 4px;padding:14px 16px;border:1px solid rgba(85,214,255,.28);background:rgba(3,14,27,.42);border-radius:16px}
.objective-label{font-size:.72rem;letter-spacing:.12em;font-weight:850;color:#b9efff;margin-bottom:7px}
.objective-input{width:100%;border:0;border-bottom:1px dashed rgba(255,255,255,.25);outline:none;background:transparent;color:#fff;font-size:1.02rem;font-weight:650;padding:4px 0 8px}
.objective-input:focus{border-bottom-color:var(--accent)}
.objective-hint{font-size:.7rem;color:var(--muted);margin-top:7px}
.p-objective{width:min(1000px,90vw);padding:12px 18px;margin:0 0 14px;border:1px solid rgba(255,255,255,.2);border-radius:15px;background:rgba(0,0,0,.22)}
.p-objective span{display:block;font-size:.72rem;letter-spacing:.14em;color:#b9efff;font-weight:850;margin-bottom:5px}
.p-objective strong{font-size:clamp(1.05rem,2.2vw,1.8rem);line-height:1.3}
</style>
</head>
<body>
<div class="app" id="app">
<header class="topbar">
  <div class="brand">Classroom <span>Hub</span></div>
  <div class="class-pill">Computer Science Principles</div>
  <div class="live-pill"><span class="live-dot"></span><span id="headerClock">--:--</span></div>
  <select id="roleSelect" class="role-select" aria-label="View role">
    <option value="teacher">Teacher View</option>
    <option value="student">Student View</option>
  </select>
  <button class="icon-btn" id="settingsBtn" title="Settings" aria-label="Settings">⚙</button>
</header>

<main>
  <section class="hero">
    <div class="hero-card">
      <div class="eyebrow">Classroom command center</div>
      <h1>Make expectations visible.</h1>
      <p class="muted">Choose an activity, start the timer, and project exactly what students need to do.</p>
      <div class="objective-box">
        <div class="objective-label">🎯 LEARNING OBJECTIVE</div>
        <input id="learningObjective" class="objective-input" aria-label="Learning objective"
          value="Students will explain the concept, apply their knowledge, and communicate their solution." />
        <div class="objective-hint">Click to edit · Press Enter or click away to save</div>
      </div>
      <div class="controls" style="justify-content:flex-start">
        <button class="primary" id="projectorBtn">▣ Projector Mode</button>
        <button class="secondary teacher-only" id="newActivityBtn">＋ Create Activity</button>
        <button class="secondary" id="helpGuideBtn">❓ What should I do?</button>
      </div>
    </div>
    <div class="hero-card clock-card">
      <div class="eyebrow">Live classroom clock</div>
      <div class="clock" id="bigClock">--:--</div>
      <div class="date" id="bigDate">--</div>
    </div>
  </section>

  <section class="dashboard">
    <div class="card now-playing">
      <div class="now-head">
        <div>
          <div class="eyebrow">Now playing</div>
          <div class="activity-title" id="activityTitle">Pair Programming</div>
          <div class="mode-tag" id="modeTag">👥 Driver + Navigator · 🤫 Whisper</div>
        </div>
        <button class="secondary teacher-only" id="editCurrentBtn">Edit</button>
      </div>
      <div class="timer" id="timerDisplay">08:42</div>
      <div class="progress"><div id="progressBar"></div></div>
      <div class="controls teacher-only">
        <button class="primary" id="startPauseBtn">▶ Start</button>
        <button class="secondary" id="resetBtn">↻ Reset</button>
        <button class="secondary" id="minusBtn">− 30s</button>
        <button class="secondary" id="plusBtn">＋ 30s</button>
        <button class="secondary" id="fullBtn">⛶ Full Screen</button>
      </div>
      <div class="controls" style="margin-top:9px">
        <button class="secondary" id="switchRoleBtn">⇄ Switch Roles</button>
      </div>
      <div class="presets teacher-only">
        <button class="preset" data-min="1">Think · 1m</button>
        <button class="preset" data-min="3">Pair · 3m</button>
        <button class="preset" data-min="5">Discuss · 5m</button>
        <button class="preset" data-min="10">Practice · 10m</button>
        <button class="preset" data-min="15">Create · 15m</button>
        <button class="preset" data-min="20">Challenge · 20m</button>
      </div>
    </div>

    <div class="card">
      <div class="section-title"><h2>Student Status</h2><span class="muted" id="statusTotal">23 students</span></div>
      <div class="status-list">
        <div class="status"><span>🟡 Need Help</span><span class="badge yellow" id="helpCount">3</span></div>
        <div class="status"><span>🔵 Need Partner</span><span class="badge blue" id="partnerCount">2</span></div>
        <div class="status"><span>🔴 Technical Problem</span><span class="badge red" id="techCount">1</span></div>
        <div class="status"><span>🟢 Working</span><span class="badge green" id="workingCount">18</span></div>
      </div>
      <button class="secondary teacher-only" style="width:100%;margin-top:11px" id="clearRequestsBtn">Clear Help Requests</button>
    </div>
  </section>

  <section class="section card teacher-only">
    <div class="section-title"><h2>Quick Activities</h2><span class="muted">One click to launch</span></div>
    <div class="activity-cards" id="activityCards"></div>
  </section>

  <section class="section card">
    <div class="section-title"><h2>Collaboration Mode</h2><span class="muted">Current: <b id="currentModeText">Pair Programming</b></span></div>
    <div class="grid" id="modeGrid"></div>
  </section>

  <section class="section dashboard">
    <div class="card">
      <div class="section-title"><h2>Classroom Signals</h2><span class="muted">Project a clear message</span></div>
      <div class="signal-grid" id="signalGrid"></div>
      <div id="signalMessage" class="status" style="margin-top:11px;display:none"></div>
    </div>
    <div class="card">
      <div class="section-title"><h2>Voice Level</h2><span class="muted">Expected for this activity</span></div>
      <div class="quick-grid" id="voiceGrid"></div>
    </div>
  </section>

  <section class="section card">
    <div class="section-title"><h2>Recent Activities</h2><span class="muted">Saved locally on this device</span></div>
    <div id="historyList" class="status-list"></div>
  </section>
</main>
</div>

<div class="modal" id="activityModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div class="modal-box">
    <div class="modal-head"><h2 id="modalTitle">Create Activity</h2><button class="icon-btn" id="closeModal">×</button></div>
    <form class="form" id="activityForm">
      <div class="form-row">
        <div><label>Activity name</label><input id="fName" required placeholder="Binary Number Challenge"></div>
        <div><label>Duration (minutes)</label><input id="fDuration" type="number" min="1" max="180" value="10" required></div>
      </div>
      <div><label>Instructions</label><textarea id="fInstructions" required placeholder="Convert the given decimal numbers into binary with your partner."></textarea></div>
      <div class="form-row">
        <div><label>Collaboration mode</label><select id="fMode"></select></div>
        <div><label>Voice level</label><select id="fVoice"></select></div>
      </div>
      <div class="form-row">
        <div><label>Group size</label><input id="fGroup" value="2"></div>
        <div><label>Success criteria</label><input id="fSuccess" value="Both partners can explain the answer."></div>
      </div>
      <div><label>Teacher notes</label><textarea id="fNotes" placeholder="Optional notes"></textarea></div>
      <div class="controls" style="justify-content:flex-end">
        <button type="button" class="secondary" id="cancelModal">Cancel</button>
        <button class="primary" type="submit">START ACTIVITY</button>
      </div>
    </form>
  </div>
</div>

<div class="modal" id="helpModal" role="dialog" aria-modal="true" aria-labelledby="helpTitle">
  <div class="modal-box">
    <div class="modal-head"><h2 id="helpTitle">❓ What should I do?</h2><button class="icon-btn" id="closeHelp">×</button></div>
    <div class="help-guide">
      <div class="guide-step"><b>1. Do I understand the task?</b><br><span class="muted">YES → Start working.</span></div>
      <div class="guide-step"><b>2. Can I figure it out myself?</b><br><span class="muted">YES → Try again.</span></div>
      <div class="guide-step"><b>3. Can I ask my neighbor?</b><br><span class="muted">YES → Ask your neighbor.</span></div>
      <div class="guide-step"><b>4. Still stuck?</b><br><span class="muted">Ask the teacher.</span></div>
    </div>
    <div class="controls" style="margin-top:14px">
      <button class="secondary student-action" data-request="help">🆘 I need help</button>
      <button class="secondary student-action" data-request="partner">👥 I need a partner</button>
      <button class="secondary student-action" data-request="time">🔄 I need more time</button>
      <button class="secondary student-action" data-request="tech">💻 Technical problem</button>
    </div>
  </div>
</div>

<div class="modal" id="settingsModal" role="dialog" aria-modal="true" aria-labelledby="settingsTitle">
  <div class="modal-box">
    <div class="modal-head"><h2 id="settingsTitle">Settings</h2><button class="icon-btn" id="closeSettings">×</button></div>
    <div class="form">
      <div class="form-row">
        <div><label>Clock format</label><select id="clockFormat"><option value="12">12-hour</option><option value="24">24-hour</option></select></div>
        <div><label>Theme</label><select id="themeSelect"></select></div>
      </div>
      <div class="form-row">
        <div><label>Seconds on clock</label><select id="secondsSelect"><option value="yes">Show</option><option value="no">Hide</option></select></div>
        <div><label>Timer sound</label><select id="soundSelect"><option value="yes">On</option><option value="no">Off</option></select></div>
      </div>
      <div><label>Learning objective</label><input id="settingsObjective" placeholder="Enter today's learning objective"></div>
      <div class="form-row">
        <button class="secondary" id="saveSettings">Save Settings</button>
        <button class="danger" id="resetAll">Reset Local Data</button>
      </div>
      <div class="muted">Shortcuts: Space = Start/Pause · R = Reset · F = Projector · C = Clock · T = Timer · P = Pair Programming · W = Whisper · Q = Quiet · Esc = Exit projector.</div>
    </div>
  </div>
</div>

<div class="projector" id="projector">
  <button class="icon-btn projector-close" id="closeProjector" aria-label="Exit projector mode">×</button>
  <div class="p-mode" id="pMode">PAIR PROGRAMMING</div>
  <h1 id="pTitle">Pair Programming</h1>
  <div class="p-objective"><span>🎯 LEARNING OBJECTIVE</span><strong id="pObjective">Students will explain the concept, apply their knowledge, and communicate their solution.</strong></div>
  <div class="p-instructions" id="pInstructions">Work with one partner. One person is the Driver and one person is the Navigator. Switch roles regularly.</div>
  <div class="p-timer" id="pTimer">08:42</div>
  <div class="p-meta"><span id="pVoice">🤫 WHISPER</span><span>•</span><span id="pExtra">Switch roles when the timer reaches 2:00</span></div>
</div>

<div class="toast" id="toast"></div>

<script>
const modeData = {
  together:{icon:"🤝",title:"Work Together",instruction:"Work together with your group. Share ideas, listen to each other, and complete the task together."},
  pair:{icon:"👥",title:"Pair Programming",instruction:"Work with one partner. One person is the Driver and one person is the Navigator. Switch roles regularly."},
  whisper:{icon:"🤫",title:"Whisper",instruction:"Talk quietly with the person next to you. Keep your voice low enough that other groups cannot hear your conversation."},
  neighbor:{icon:"🗣️",title:"Ask Your Neighbor",instruction:"Ask the person next to you before asking the teacher."},
  thinkpair:{icon:"🧠",title:"Think-Pair-Share",instruction:"THINK → PAIR → SHARE. Think independently, discuss with a partner, then share your ideas."},
  independent:{icon:"👤",title:"Independent Work",instruction:"Work independently. Stay focused and try the task yourself before asking for help."},
  group:{icon:"👨‍👩‍👧‍👦",title:"Group Challenge",instruction:"Work as a team to solve the challenge. Make sure everyone contributes."}
};
const voiceData = {
  silent:{icon:"🔴",title:"Silent",text:"No talking."},
  whisper:{icon:"🟡",title:"Whisper",text:"Only your partner can hear you."},
  conversation:{icon:"🟢",title:"Conversation",text:"Your group can hear you."},
  presentation:{icon:"🔵",title:"Presentation",text:"Everyone should be able to hear you."}
};
const signals = [
  ["quiet","🔇 Quiet","Voices off, please."],["whisper","🤫 Whisper","Whisper voices only."],
  ["eyes","👀 Eyes on Teacher","Pause and look this way."],["work","💻 Back to Work","Return to your task."],
  ["think","🧠 Think","Take a moment to think independently."],["partner","👥 Find a Partner","Find a partner and begin."],
  ["stop","🛑 Stop","Stop and listen."],["great","🎉 Great Work","Excellent work! Keep going."]
];
const quickActivities = [
  {name:"Work Together",mode:"together",voice:"conversation",duration:8,icon:"🤝"},
  {name:"Pair Programming",mode:"pair",voice:"whisper",duration:10,icon:"👥"},
  {name:"Think-Pair-Share",mode:"thinkpair",voice:"conversation",duration:8,icon:"🧠"},
  {name:"Whisper",mode:"whisper",voice:"whisper",duration:5,icon:"🤫"},
  {name:"Ask Your Neighbor",mode:"neighbor",voice:"whisper",duration:3,icon:"🗣️"},
  {name:"Independent Work",mode:"independent",voice:"silent",duration:15,icon:"👤"},
  {name:"Group Challenge",mode:"group",voice:"conversation",duration:20,icon:"👨‍👩‍👧‍👦"},
  {name:"Binary Number Challenge",mode:"pair",voice:"whisper",duration:10,icon:"💻"}
];
const themes = {
  "Ocean Blue":["#07111f","#0d1930","#102744","#55d6ff","#7b61ff"],
  "Purple Aurora":["#10081d","#24113c","#18285a","#c084fc","#7b61ff"],
  "Sunset":["#1e0e13","#3b1422","#3b1f3e","#ffb86b","#f05aa6"],
  "Fresh Green":["#071b17","#0c3028","#143f38","#59e391","#19b6a5"],
  "Midnight":["#040817","#0b1027","#17133c","#8da2ff","#7655ff"],
  "Soft Lavender":["#171522","#302b45","#4b4261","#d8c7ff","#a78bfa"],
  "Sky":["#071925","#0e3142","#214e66","#8ee7ff","#4db7e8"],
  "Neon Future":["#050916","#0a1132","#11175a","#35f0ff","#a855f7"]
};
let saved = JSON.parse(localStorage.getItem("classroomHub") || "{}");
let state = {
  mode:saved.mode || "pair",
  voice:saved.voice || "whisper",
  theme:saved.theme || "Ocean Blue",
  learningObjective:saved.learningObjective || "Students will explain the concept, apply their knowledge, and communicate their solution.",
  clockFormat:saved.clockFormat || "12",
  seconds:saved.seconds || "yes",
  sound:saved.sound || "yes",
  role:"teacher",
  activity:saved.activity || {name:"Pair Programming",mode:"pair",voice:"whisper",duration:10,instructions:modeData.pair.instruction},
  remaining:saved.remaining ?? 522,
  total:saved.total ?? 600,
  running:false,
  roleSwapped:false,
  requests:saved.requests || {help:3,partner:2,tech:1,time:0},
  history:saved.history || quickActivities.slice(0,5).map(x=>({...x}))
};
let timerInterval=null, clockInterval=null;

function persist(){
  localStorage.setItem("classroomHub",JSON.stringify({
    mode:state.mode,voice:state.voice,theme:state.theme,clockFormat:state.clockFormat,
    seconds:state.seconds,sound:state.sound,learningObjective:state.learningObjective,activity:state.activity,remaining:state.remaining,total:state.total,
    requests:state.requests,history:state.history
  }));
}
function esc(s){return String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function fmt(sec){
  sec=Math.max(0,Math.round(sec)); const m=Math.floor(sec/60),s=sec%60;
  return `${String(m).padStart(2,"0")}:${String(s).padStart(2,"0")}`;
}
function showToast(msg){const t=document.getElementById("toast");t.textContent=msg;t.classList.add("show");clearTimeout(showToast.x);showToast.x=setTimeout(()=>t.classList.remove("show"),2200)}
function applyTheme(){
  const c=themes[state.theme]||themes["Ocean Blue"];
  document.documentElement.style.setProperty("--bg",c[0]);document.documentElement.style.setProperty("--panel",c[1]);
  document.documentElement.style.setProperty("--panel2",c[2]);document.documentElement.style.setProperty("--accent",c[3]);document.documentElement.style.setProperty("--accent2",c[4]);
  document.body.style.background=`radial-gradient(circle at 15% 15%,${c[3]}33,transparent 30%),radial-gradient(circle at 85% 10%,${c[4]}33,transparent 30%),linear-gradient(135deg,${c[0]},${c[1]} 48%,${c[2]})`;
}
function updateClock(){
  const d=new Date(), opts={weekday:"long",month:"long",day:"numeric"};
  const time=d.toLocaleTimeString([], {hour:"numeric",minute:"2-digit",second:state.seconds==="yes"?"2-digit":undefined,hour12:state.clockFormat==="12"});
  document.getElementById("bigClock").textContent=time;
  document.getElementById("headerClock").textContent=time;
  document.getElementById("bigDate").textContent=d.toLocaleDateString([],opts);
}
function renderModes(){
  document.getElementById("modeGrid").innerHTML=Object.entries(modeData).map(([k,v])=>`
    <button class="mode-btn ${state.mode===k?"active":""}" data-mode="${k}">
      <strong>${v.icon} ${v.title}</strong><small>${esc(v.instruction)}</small>
    </button>`).join("");
  document.getElementById("currentModeText").textContent=modeData[state.mode].title;
  document.querySelectorAll("[data-mode]").forEach(b=>b.onclick=()=>setMode(b.dataset.mode));
}
function renderActivities(){
  document.getElementById("activityCards").innerHTML=quickActivities.map((a,i)=>`
    <div class="activity-card" data-quick="${i}">
      <div class="icon">${a.icon}</div><h3>${esc(a.name)}</h3><p>${a.duration} min · ${voiceData[a.voice].title}</p>
    </div>`).join("");
  document.querySelectorAll("[data-quick]").forEach(x=>x.onclick=()=>launchActivity(quickActivities[+x.dataset.quick]));
}
function renderSignals(){
  document.getElementById("signalGrid").innerHTML=signals.map(s=>`<button class="signal" data-signal="${s[0]}">${s[1]}</button>`).join("");
  document.querySelectorAll("[data-signal]").forEach(b=>b.onclick=()=>signal(b.dataset.signal));
}
function renderVoice(){
  document.getElementById("voiceGrid").innerHTML=Object.entries(voiceData).map(([k,v])=>`
    <button class="signal ${state.voice===k?"active":""}" data-voice="${k}">${v.icon} ${v.title}<br><small>${v.text}</small></button>`).join("");
  document.querySelectorAll("[data-voice]").forEach(b=>b.onclick=()=>{state.voice=b.dataset.voice;persist();renderVoice();renderNow()});
}
function renderHistory(){
  document.getElementById("historyList").innerHTML=state.history.length ? state.history.slice(0,8).map((a,i)=>`
    <div class="status"><span><b>${a.icon||"📘"} ${esc(a.name)}</b><span class="muted"> · ${a.duration} min · ${voiceData[a.voice]?.title||"Conversation"}</span></span>
    <span class="controls"><button class="secondary" data-reuse="${i}">Reuse</button><button class="danger" data-delete="${i}">Delete</button></span></div>`).join("") :
    `<div class="status"><span class="muted">No saved activities yet.</span></div>`;
  document.querySelectorAll("[data-reuse]").forEach(b=>b.onclick=()=>launchActivity(state.history[+b.dataset.reuse]));
  document.querySelectorAll("[data-delete]").forEach(b=>b.onclick=()=>{state.history.splice(+b.dataset.delete,1);persist();renderHistory()});
}
function renderNow(){
  document.getElementById("learningObjective").value=state.learningObjective;
  document.getElementById("pObjective").textContent=state.learningObjective;
  document.getElementById("activityTitle").textContent=state.activity.name;
  document.getElementById("modeTag").textContent=`${modeData[state.activity.mode]?.icon||"📘"} ${modeData[state.activity.mode]?.title||state.activity.mode} · ${voiceData[state.activity.voice]?.icon||"🔵"} ${voiceData[state.activity.voice]?.title||"Conversation"}`;
  document.getElementById("timerDisplay").textContent=fmt(state.remaining);
  document.getElementById("timerDisplay").className="timer"+(state.remaining<=10&&state.remaining>0?" warning":"")+(state.remaining===0?" done":"");
  document.getElementById("progressBar").style.width=Math.min(100,Math.max(0,(1-state.remaining/state.total)*100))+"%";
  document.getElementById("startPauseBtn").textContent=state.running?"❚❚ Pause":"▶ Start";
  document.getElementById("pMode").textContent=(modeData[state.activity.mode]?.title||"ACTIVITY").toUpperCase();
  document.getElementById("pTitle").textContent=state.activity.name;
  document.getElementById("pInstructions").textContent=state.activity.instructions||modeData[state.activity.mode]?.instruction||"Follow the classroom instructions.";
  document.getElementById("pTimer").textContent=fmt(state.remaining);
  document.getElementById("pVoice").textContent=`${voiceData[state.activity.voice]?.icon||"🔵"} ${(voiceData[state.activity.voice]?.title||"CONVERSATION").toUpperCase()}`;
  document.getElementById("pExtra").textContent=state.activity.mode==="pair"?"Switch roles regularly.":state.activity.mode==="thinkpair"?"THINK → PAIR → SHARE":"Stay focused and follow the instructions.";
  document.getElementById("switchRoleBtn").style.display=state.activity.mode==="pair"?"inline-block":"none";
}
function updateRequests(){
  document.getElementById("helpCount").textContent=state.requests.help;
  document.getElementById("partnerCount").textContent=state.requests.partner;
  document.getElementById("techCount").textContent=state.requests.tech;
  document.getElementById("workingCount").textContent=Math.max(0,23-state.requests.help-state.requests.partner-state.requests.tech);
}
function setMode(mode){
  state.mode=mode; state.activity.mode=mode; state.activity.instructions=modeData[mode].instruction;
  if(mode==="whisper"||mode==="pair"||mode==="neighbor")state.voice="whisper";
  persist();renderModes();renderVoice();renderNow();showToast(`${modeData[mode].title} selected`);
}
function launchActivity(a){
  state.activity={...a,instructions:a.instructions||modeData[a.mode].instruction};
  state.mode=a.mode;state.voice=a.voice||"conversation";state.total=a.duration*60;state.remaining=state.total;state.running=false;
  state.history=[{...a},...state.history.filter(x=>x.name!==a.name)].slice(0,12);
  persist();renderModes();renderVoice();renderHistory();renderNow();showToast(`${a.name} is ready`);
}
function playAlarm(){
  if(state.sound!=="yes") return;
  try{
    const C=window.AudioContext||window.webkitAudioContext;if(!C)return;
    const ctx=new C(), now=ctx.currentTime;
    [0,.28,.56].forEach((o,i)=>{
      const osc=ctx.createOscillator(), gain=ctx.createGain();
      osc.type="sine";osc.frequency.value=i===1?880:660;
      gain.gain.setValueAtTime(.0001,now+o);
      gain.gain.exponentialRampToValueAtTime(.22,now+o+.02);
      gain.gain.exponentialRampToValueAtTime(.0001,now+o+.22);
      osc.connect(gain);gain.connect(ctx.destination);
      osc.start(now+o);osc.stop(now+o+.24);
    });
    setTimeout(()=>ctx.close().catch(()=>{}),1000);
  }catch(e){}
}

function tick(){
  if(!state.running)return;
  if(state.remaining>0){state.remaining--;renderNow();persist()}
  if(state.remaining===0){
    state.running=false; clearInterval(timerInterval); timerInterval=null; renderNow();
    showToast("⏰ Time is up!");
    playAlarm();
  }
}
function toggleTimer(){
  if(state.remaining===0)state.remaining=state.total;
  state.running=!state.running;
  if(state.running){clearInterval(timerInterval);timerInterval=setInterval(tick,1000)}
  else {clearInterval(timerInterval);timerInterval=null}
  renderNow();
}
function resetTimer(){state.running=false;clearInterval(timerInterval);timerInterval=null;state.remaining=state.total;renderNow();persist()}
function changeTime(delta){state.remaining=Math.max(0,state.remaining+delta);state.total=Math.max(state.total,state.remaining);renderNow();persist()}
function signal(key){
  const s=signals.find(x=>x[0]===key); if(!s)return;
  const box=document.getElementById("signalMessage");box.style.display="flex";box.innerHTML=`<span><b>${s[1]}</b> · ${s[2]}</span>`;
  document.querySelectorAll(".signal").forEach(x=>x.classList.toggle("active",x.dataset.signal===key));
  document.getElementById("pExtra").textContent=s[2];showToast(s[2]);
}
function openModal(id){document.getElementById(id).classList.add("open")}
function closeModal(id){document.getElementById(id).classList.remove("open")}
function populateForms(){
  document.getElementById("fMode").innerHTML=Object.entries(modeData).map(([k,v])=>`<option value="${k}">${v.icon} ${v.title}</option>`).join("");
  document.getElementById("fVoice").innerHTML=Object.entries(voiceData).map(([k,v])=>`<option value="${k}">${v.icon} ${v.title}</option>`).join("");
  document.getElementById("themeSelect").innerHTML=Object.keys(themes).map(k=>`<option>${k}</option>`).join("");
  document.getElementById("clockFormat").value=state.clockFormat;document.getElementById("secondsSelect").value=state.seconds;document.getElementById("soundSelect").value=state.sound;document.getElementById("themeSelect").value=state.theme;document.getElementById("settingsObjective").value=state.learningObjective;
}
const objectiveInput=document.getElementById("learningObjective");
objectiveInput.addEventListener("keydown",e=>{if(e.key==="Enter"){e.preventDefault();objectiveInput.blur()}});
objectiveInput.addEventListener("blur",()=>{
  const v=objectiveInput.value.trim();
  if(v){state.learningObjective=v;persist();document.getElementById("pObjective").textContent=v;showToast("Learning objective saved")}
});
document.getElementById("startPauseBtn").onclick=toggleTimer;
document.getElementById("resetBtn").onclick=resetTimer;
document.getElementById("minusBtn").onclick=()=>changeTime(-30);
document.getElementById("plusBtn").onclick=()=>changeTime(30);
document.getElementById("fullBtn").onclick=()=>openProjector();
document.getElementById("projectorBtn").onclick=openProjector;
document.getElementById("closeProjector").onclick=closeProjector;
document.getElementById("newActivityBtn").onclick=()=>{document.getElementById("modalTitle").textContent="Create Activity";document.getElementById("activityForm").reset();document.getElementById("fMode").value=state.mode;document.getElementById("fVoice").value=state.voice;openModal("activityModal")};
document.getElementById("closeModal").onclick=()=>closeModal("activityModal");
document.getElementById("cancelModal").onclick=()=>closeModal("activityModal");
document.getElementById("helpGuideBtn").onclick=()=>openModal("helpModal");
document.getElementById("closeHelp").onclick=()=>closeModal("helpModal");
document.getElementById("settingsBtn").onclick=()=>openModal("settingsModal");
document.getElementById("closeSettings").onclick=()=>closeModal("settingsModal");
document.getElementById("saveSettings").onclick=()=>{
  state.clockFormat=document.getElementById("clockFormat").value;state.seconds=document.getElementById("secondsSelect").value;
  state.sound=document.getElementById("soundSelect").value;state.theme=document.getElementById("themeSelect").value;state.learningObjective=document.getElementById("settingsObjective").value.trim()||state.learningObjective;
  applyTheme();persist();updateClock();closeModal("settingsModal");showToast("Settings saved");
};
document.getElementById("resetAll").onclick=()=>{
  if(confirm("Reset all saved Classroom Hub data?")){localStorage.removeItem("classroomHub");location.reload()}
};
document.getElementById("clearRequestsBtn").onclick=()=>{state.requests={help:0,partner:0,tech:0,time:0};updateRequests();persist();showToast("Help requests cleared")};
document.getElementById("switchRoleBtn").onclick=()=>{
  state.roleSwapped=!state.roleSwapped;showToast(state.roleSwapped?"Roles switched: Navigator is now Driver":"Roles reset: Driver is now Driver");
  document.getElementById("pExtra").textContent=state.roleSwapped?"Navigator is now Driver. Switch roles regularly.":"Driver + Navigator. Switch roles regularly.";
};
document.getElementById("editCurrentBtn").onclick=()=>{
  document.getElementById("modalTitle").textContent="Edit Current Activity";
  document.getElementById("fName").value=state.activity.name;document.getElementById("fDuration").value=Math.ceil(state.total/60);
  document.getElementById("fInstructions").value=state.activity.instructions||"";document.getElementById("fMode").value=state.activity.mode;
  document.getElementById("fVoice").value=state.activity.voice;document.getElementById("fGroup").value=state.activity.group||"2";
  document.getElementById("fSuccess").value=state.activity.success||"";document.getElementById("fNotes").value=state.activity.notes||"";
  openModal("activityModal");
};
document.getElementById("activityForm").onsubmit=e=>{
  e.preventDefault();
  const a={name:document.getElementById("fName").value.trim(),duration:+document.getElementById("fDuration").value,
    mode:document.getElementById("fMode").value,voice:document.getElementById("fVoice").value,
    instructions:document.getElementById("fInstructions").value.trim(),group:document.getElementById("fGroup").value,
    success:document.getElementById("fSuccess").value.trim(),notes:document.getElementById("fNotes").value.trim(),icon:modeData[document.getElementById("fMode").value].icon};
  launchActivity(a);closeModal("activityModal");
};
document.querySelectorAll(".student-action").forEach(b=>b.onclick=()=>{
  const k=b.dataset.request;state.requests[k]=(state.requests[k]||0)+1;updateRequests();persist();showToast("Request sent to teacher");closeModal("helpModal");
});
document.getElementById("roleSelect").onchange=e=>{
  state.role=e.target.value;document.body.classList.toggle("student-view",state.role==="student");
  showToast(state.role==="student"?"Student view enabled":"Teacher view enabled");
};
document.querySelectorAll(".preset").forEach(b=>b.onclick=()=>{
  const mins=+b.dataset.min;state.total=mins*60;state.remaining=state.total;state.running=false;clearInterval(timerInterval);renderNow();persist();showToast(`${mins}-minute timer set`);
});
function openProjector(){renderNow();document.getElementById("projector").classList.add("open");document.documentElement.requestFullscreen?.().catch(()=>{})}
function closeProjector(){document.getElementById("projector").classList.remove("open");if(document.fullscreenElement)document.exitFullscreen?.().catch(()=>{})}
document.addEventListener("keydown",e=>{
  if(e.target.matches("input,textarea,select"))return;
  const k=e.key.toLowerCase();
  if(k==="escape"){closeProjector();return}
  if(k===" "){e.preventDefault();toggleTimer()}
  else if(k==="r")resetTimer(); else if(k==="f")openProjector(); else if(k==="t")document.getElementById("timerDisplay").scrollIntoView({behavior:"smooth"});
  else if(k==="c")document.getElementById("bigClock").scrollIntoView({behavior:"smooth"});
  else if(k==="p")setMode("pair"); else if(k==="w")setMode("whisper"); else if(k==="q")signal("quiet");
});
window.addEventListener("beforeunload",persist);
populateForms();applyTheme();renderActivities();renderModes();renderSignals();renderVoice();renderHistory();updateRequests();renderNow();updateClock();
clockInterval=setInterval(updateClock,1000);
</script>
</body>
</html>
